pipeline {
    agent any
    tools {
        jdk "JDK21"
        maven "maven3"
        nodejs "nodejs26"
    }
    environment {
        ENV_NAME = "dev"
        BUILD_VERSION = "${ENV_NAME}-build${env.BUILD_NUMBER}"
    }
    stage('0.查看源码目录结构') {
        steps {
            sh 'ls -l'
            sh 'ls -l */'
        }
    }
    stages {
        stage('1.打印构建版本') {
            steps {
                echo "当前构建环境=${ENV_NAME},构建版本号=${BUILD_VERSION}"
            }
        }

        stage('2.后端Maven打包Java') {
            steps {
                dir("weighing-system-backend") {
                    sh '''
                    mvn clean package -DskipTests
                    '''
                }
            }
        }

        stage('3.前端Vue编译打包') {
            steps {
                dir("weighing-frontend") {
                    sh '''
                    npm config set registry https://registry.npmmirror.com
                    npm install
                    npm run build
                    '''
                }
            }
        }

        stage('4.归档构建产物') {
            steps {
                // 将 archiveArtifacts 放在 steps 中
                // 注意：如果前面的 stage 失败，这个 stage 默认不会执行。
                // 如果你希望即使前面失败也尝试归档，需要使用 catchError 或改变 pipeline 策略，
                // 但通常归档只在成功时进行。
                script {
                    // 使用 script 块可以更灵活地处理，或者直接调用 step
                    archiveArtifacts artifacts: 'weighing-system-backend/target/*.jar, weighing-frontend/dist/**', fingerprint: true, allowEmptyArchive: false
                }
            }
            // 如果确实需要在 post 中做额外处理，可以保留 post，但必须有 steps
            post {
                success {
                    echo "✅ 产物归档成功"
                }
                failure {
                    echo "❌ 产物归档失败"
                }
            }
        }
    }

    post {
        success {
            echo "✅流水线打包完成！版本：${BUILD_VERSION}"
            echo "👉 Jenkins页面【构建产物】可以下载后端jar、前端dist包"
        }
        failure {
            echo "❌流水线打包执行失败！查看控制台日志排查问题"
        }
    }
}
